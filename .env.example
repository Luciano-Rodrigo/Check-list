NODE_ENV=development
DATABASE_URL=postgresql://usuario:senha@host:5432/banco
PGSSLMODE=require
PORT=5173
# Railway: use NODE_ENV=production and let Railway supply PORT.
# Keep sandbox until the full payment + webhook flow has been validated.
ASAAS_ENV=sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
# Paid plans require both a real API key and a random webhook token (32+ chars).
PLAN_PERSONAL_PRICE=9.90
PLAN_COMPANY_PRICE=34.90
# Empresa inclui 2 colaboradores. Cada colaborador a partir do 3º soma este valor à mensalidade.
PLAN_COMPANY_EXTRA_COLLABORATOR_PRICE=4.90
ADMIN_PASSWORD=
# Railway only: allow graceful shutdown during redeploys.
RAILWAY_DEPLOYMENT_DRAINING_SECONDS=30
